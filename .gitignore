# ============================================
# MediFind Monorepo - Root .gitignore
# ============================================

# Environment variables - NEVER commit these
.env
.env.*
.env.local
.env.*.local
!.env.example

# Node modules
node_modules/

# IDE and Editor configs
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
*.apk
*.aab
*.ipa
*.tgz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# Certificates and Keys
*.pem
*.p12
*.p8
*.key
*.jks
*.mobileprovision

# Secrets folder
secrets/
**/secrets/
